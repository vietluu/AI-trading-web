{
  "name": "ai-trading-agents",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "msgpackr-extract",
      "@prisma/engines",
      "@prisma/client",
      "argon2",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @platform/shared build && pnpm --parallel --filter @platform/api --filter @platform/web dev",
    "build": "pnpm -r --if-present build",
    "prelint": "pnpm --filter @platform/shared build",
    "lint": "pnpm -r --if-present lint",
    "pretypecheck": "pnpm --filter @platform/shared build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm --filter @platform/shared build",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @platform/api test:integration",
    "test:e2e": "pnpm --filter @platform/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @platform/api db:generate",
    "db:migrate": "pnpm --filter @platform/api db:migrate",
    "db:studio": "pnpm --filter @platform/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^15.4.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
