{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run test/phase2.integration.spec.ts test/phase3.integration.spec.ts test/external-data/phase5.integration.spec.ts",
    "test:e2e": "RUN_E2E_TESTS=true vitest run test/phase3.e2e.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "trade-ledger:backfill": "node dist/scripts/backfill-trade-ledger.js",
    "quant:backfill": "node dist/scripts/backfill-real-quant.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/platform-socket.io": "^11.1.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "^11.1.5",
    "@platform/shared": "workspace:*",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^5.6.1",
    "nodemailer": "^9.0.5",
    "prisma": "^6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.10",
    "source-map-support": "^0.5.21",
    "vitest": "^3.2.4"
  }
}
