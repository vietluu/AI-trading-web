generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CredentialProvider {
  OPENAI
  BINANCE
  OKX
  BINANCE_FUTURES
  OKX_FUTURES
  NEWS_API
  CUSTOM
}

enum ExchangeProvider {
  BINANCE_FUTURES
  OKX_FUTURES
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
  PRODUCTION
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique
  username            String                @unique
  passwordHash        String
  failedLogins        Int                   @default(0)
  lockedUntil         DateTime?
  emailVerifiedAt     DateTime?
  totpSecret          String?
  totpEnabledAt       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sessions            Session[]
  credentials         EncryptedCredential[]
  setting             UserSetting?
  auditLogs           AuditLog[]
  exchangeConnections ExchangeConnection[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionId    String    @unique
  tokenFamily  String
  generation   Int       @default(0)
  csrfHash     String
  fingerprint  String
  rememberMe   Boolean   @default(false)
  revokedAt    DateTime?
  rotatedAt    DateTime?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("sessions")
}

model EncryptedCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  provider           CredentialProvider
  label              String?
  encryptedData      String
  lastFour           String
  status             String              @default("NOT_VERIFIED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastVerified       DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeConnection ExchangeConnection?

  @@unique([userId, provider, label])
  @@index([userId])
  @@map("encrypted_credentials")
}

model ExchangeConnection {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  provider      ExchangeProvider
  environment   ExchangeEnvironment
  credentialId  String              @unique @db.Uuid
  displayName   String?
  isEnabled     Boolean             @default(true)
  isVerified    Boolean             @default(false)
  verifiedAt    DateTime?
  permissions   Json?
  lastErrorCode String?
  lastErrorAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential    EncryptedCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, environment])
  @@index([userId])
  @@index([provider, environment])
  @@map("exchange_connections")
}

model UserSetting {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  theme               String   @default("dark")
  timezone            String   @default("UTC")
  preferredExchange   String?
  preferredSymbols    String[] @default([])
  preferredTimeframes String[] @default([])
  aiDailyBudget       Decimal  @default(0) @db.Decimal(18, 2)
  paperTradingBalance Decimal  @default(10000) @db.Decimal(24, 8)
  defaultLeverage     Int      @default(1)
  riskPreference      String   @default("CONSERVATIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
