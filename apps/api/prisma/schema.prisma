generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CredentialProvider {
  OPENAI
  BINANCE
  OKX
  BINANCE_FUTURES
  OKX_FUTURES
  NEWS_API
  REDDIT
  CUSTOM
}

enum ExchangeProvider {
  BINANCE_FUTURES
  OKX_FUTURES
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
  PRODUCTION
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  email                  String                      @unique
  username               String                      @unique
  passwordHash           String
  failedLogins           Int                         @default(0)
  lockedUntil            DateTime?
  emailVerifiedAt        DateTime?
  totpSecret             String?
  totpEnabledAt          DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  sessions               Session[]
  credentials            EncryptedCredential[]
  setting                UserSetting?
  auditLogs              AuditLog[]
  exchangeConnections    ExchangeConnection[]
  externalDataPreference UserExternalDataPreference?
  newsStates             UserNewsState[]
  macroImportRuns        MacroImportRun[]
  aiHistories            AIHistory[]
  aiMemories             AIMemory[]
  aiConfiguration        AIConfiguration?
  aiUsages               AIUsage[]
  toolInvocations        ToolInvocationRecord[]
  toolQuotas             ToolQuotaUsage[]
  agentRuns              AgentRun[]
  agentQuotas            AgentQuotaUsage[]
  pipelineRuns           PipelineRun[]
  pipelineSchedules      PipelineSchedule[]
  performanceRecords     PerformanceRecord[]
  reflectionInsights     ReflectionInsight[]
  improvementProposals   ImprovementProposal[]
  paperAccount           PaperAccount?
  paperSignals           PaperSignal[]
  riskAssessments        RiskAssessment[]
  liveOrders             LiveOrder[]
  livePositions          LivePosition[]
  liveAccountSnapshots   LiveAccountSnapshot[]
  portfolioStrategies    PortfolioStrategy[]
  portfolioRebalances    PortfolioRebalance[]
  portfolioRiskEvents    PortfolioRiskEvent[]
  researchValidations    ResearchValidationRun[]
  benchmarkSuites        BenchmarkSuiteRun[]
  sensitivityHeatmaps    SensitivityHeatmap[]

  @@map("users")
}

// ============================================================
// Phase 10: multi-strategy portfolio management
// ============================================================

enum StrategyType {
  AI
  RULE_BASED
  HYBRID
}

enum StrategyKind {
  AI_CORE
  TREND_FOLLOWING
  MEAN_REVERSION
  BREAKOUT
  NEWS_DRIVEN
}

enum StrategyStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model PortfolioStrategy {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  key             String
  name            String
  type            StrategyType
  kind            StrategyKind
  symbols         String[]
  status          StrategyStatus        @default(ACTIVE)
  disabledReason  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocation      StrategyAllocation?
  performance     StrategyPerformance?
  positions       StrategyPosition[]
  riskEvents      PortfolioRiskEvent[]
  results         StrategyTradeResult[]
  paperPositions  PaperPosition[]
  riskAssessments RiskAssessment[]
  liveOrders      LiveOrder[]
  livePositions   LivePosition[]

  @@unique([userId, key])
  @@index([userId, status])
  @@map("portfolio_strategies")
}

model StrategyAllocation {
  id               String            @id @default(uuid()) @db.Uuid
  strategyId       String            @unique @db.Uuid
  allocatedCapital Decimal           @default(0) @db.Decimal(24, 8)
  weight           Float
  updatedAt        DateTime          @updatedAt
  strategy         PortfolioStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("strategy_allocations")
}

model StrategyPerformance {
  id            String            @id @default(uuid()) @db.Uuid
  strategyId    String            @unique @db.Uuid
  totalTrades   Int               @default(0)
  winningTrades Int               @default(0)
  winRate       Float             @default(0)
  returnPct     Float             @default(0)
  drawdownPct   Float             @default(0)
  sharpeRatio   Float?
  realizedPnl   Decimal           @default(0) @db.Decimal(24, 8)
  updatedAt     DateTime          @updatedAt
  strategy      PortfolioStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("strategy_performance")
}

model StrategyPosition {
  id            String            @id @default(uuid()) @db.Uuid
  strategyId    String            @db.Uuid
  symbol        String
  side          String
  quantity      Decimal           @db.Decimal(30, 12)
  entryPrice    Decimal           @db.Decimal(24, 8)
  markPrice     Decimal           @db.Decimal(24, 8)
  unrealizedPnl Decimal           @default(0) @db.Decimal(24, 8)
  openedAt      DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  strategy      PortfolioStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, symbol])
  @@index([symbol, side])
  @@map("strategy_positions")
}

model StrategyTradeResult {
  id         String            @id @default(uuid()) @db.Uuid
  strategyId String            @db.Uuid
  symbol     String
  pnl        Decimal           @db.Decimal(24, 8)
  returnPct  Float
  closedAt   DateTime          @default(now())
  strategy   PortfolioStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, closedAt])
  @@map("strategy_trade_results")
}

model PortfolioRiskEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  strategyId           String?            @db.Uuid
  pipelineRunId        String?            @db.Uuid
  symbol               String
  side                 String
  requestedNotional    Decimal            @db.Decimal(24, 8)
  approvedNotional     Decimal            @default(0) @db.Decimal(24, 8)
  approved             Boolean
  reason               String?
  totalExposurePct     Float
  strategyExposurePct  Float
  correlatedStrategies Int                @default(0)
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy             PortfolioStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([pipelineRunId])
  @@map("portfolio_risk_events")
}

model PortfolioRebalance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  equity       Decimal  @db.Decimal(24, 8)
  reason       String
  allocations  Json
  disabledKeys String[] @default([])
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("portfolio_rebalances")
}

// ============================================================
// Phase 7: Deterministic paper trading (simulation only)
// ============================================================

model PaperAccount {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @unique @db.Uuid
  balance    Decimal          @db.Decimal(24, 8)
  equity     Decimal          @db.Decimal(24, 8)
  marginUsed Decimal          @default(0) @db.Decimal(24, 8)
  peakEquity Decimal          @db.Decimal(24, 8)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions  PaperPosition[]
  orders     SimulatedOrder[]
  trades     PaperTrade[]

  @@map("paper_accounts")
}

model PaperPosition {
  id            String             @id @default(uuid()) @db.Uuid
  accountId     String             @db.Uuid
  strategyId    String?            @db.Uuid
  symbol        String
  side          String
  size          Decimal            @db.Decimal(30, 12)
  entryPrice    Decimal            @db.Decimal(24, 8)
  markPrice     Decimal            @db.Decimal(24, 8)
  leverage      Int
  unrealizedPnL Decimal            @default(0) @db.Decimal(24, 8)
  realizedPnL   Decimal            @default(0) @db.Decimal(24, 8)
  entryFee      Decimal            @default(0) @db.Decimal(24, 8)
  stopLoss      Decimal            @db.Decimal(24, 8)
  takeProfit    Decimal            @db.Decimal(24, 8)
  openedAt      DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  account       PaperAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy      PortfolioStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([accountId, symbol])
  @@index([accountId, updatedAt])
  @@index([strategyId])
  @@map("paper_positions")
}

model RiskAssessment {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  strategyId     String?            @db.Uuid
  pipelineRunId  String?            @unique @db.Uuid
  symbol         String
  decision       String
  confidence     Float
  approved       Boolean
  reason         String?
  positionSize   Decimal?           @db.Decimal(30, 12)
  leverage       Int?
  stopLoss       Decimal?           @db.Decimal(24, 8)
  takeProfit     Decimal?           @db.Decimal(24, 8)
  riskScore      Float
  referencePrice Decimal            @db.Decimal(24, 8)
  volatility     Float
  exposurePct    Float
  drawdownPct    Float
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy       PortfolioStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, approved, createdAt])
  @@index([strategyId, createdAt])
  @@map("risk_assessments")
}

model SimulatedOrder {
  id             String       @id @default(uuid()) @db.Uuid
  accountId      String       @db.Uuid
  pipelineRunId  String?      @db.Uuid
  symbol         String
  side           String
  type           String       @default("MARKET")
  quantity       Decimal      @db.Decimal(30, 12)
  referencePrice Decimal      @db.Decimal(24, 8)
  executedPrice  Decimal      @db.Decimal(24, 8)
  slippagePct    Decimal      @db.Decimal(12, 10)
  fee            Decimal      @db.Decimal(24, 8)
  status         String       @default("FILLED")
  purpose        String
  createdAt      DateTime     @default(now())
  account        PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([pipelineRunId])
  @@map("simulated_orders")
}

model PaperTrade {
  id          String       @id @default(uuid()) @db.Uuid
  accountId   String       @db.Uuid
  symbol      String
  side        String
  entryPrice  Decimal      @db.Decimal(24, 8)
  exitPrice   Decimal      @db.Decimal(24, 8)
  size        Decimal      @db.Decimal(30, 12)
  pnl         Decimal      @db.Decimal(24, 8)
  fee         Decimal      @db.Decimal(24, 8)
  returnPct   Decimal      @db.Decimal(18, 8)
  closeReason String
  durationMs  BigInt
  openedAt    DateTime
  closedAt    DateTime     @default(now())
  account     PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, closedAt])
  @@map("paper_trades")
}

model PaperSignal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  pipelineRunId  String?  @unique @db.Uuid
  symbol         String
  decision       String
  confidence     Float
  mode           String
  referencePrice Decimal  @db.Decimal(24, 8)
  outcome        String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("paper_signals")
}

// ============================================================
// Phase 9: exchange-backed demo/live execution
// ============================================================

model LiveOrder {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  connectionId     String             @db.Uuid
  strategyId       String?            @db.Uuid
  riskAssessmentId String?            @unique @db.Uuid
  exchangeOrderId  String?
  clientOrderId    String
  provider         String
  environment      String
  symbol           String
  side             String
  type             String             @default("MARKET")
  quantity         Decimal            @db.Decimal(30, 12)
  leverage         Int
  averagePrice     Decimal?           @db.Decimal(24, 8)
  status           String
  purpose          String             @default("OPEN")
  reduceOnly       Boolean            @default(false)
  stopLoss         Decimal?           @db.Decimal(24, 8)
  takeProfit       Decimal?           @db.Decimal(24, 8)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy         PortfolioStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([connectionId, clientOrderId])
  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([riskAssessmentId])
  @@index([strategyId, createdAt])
  @@map("live_orders")
}

model LivePosition {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  connectionId     String             @db.Uuid
  strategyId       String?            @db.Uuid
  provider         String
  environment      String
  symbol           String
  side             String
  quantity         Decimal            @db.Decimal(30, 12)
  entryPrice       Decimal            @db.Decimal(24, 8)
  markPrice        Decimal?           @db.Decimal(24, 8)
  liquidationPrice Decimal?           @db.Decimal(24, 8)
  leverage         Int?
  unrealizedPnl    Decimal            @default(0) @db.Decimal(24, 8)
  realizedPnl      Decimal?           @db.Decimal(24, 8)
  notional         Decimal?           @db.Decimal(24, 8)
  syncedAt         DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy         PortfolioStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([connectionId, symbol, side])
  @@index([userId, syncedAt])
  @@index([strategyId, syncedAt])
  @@map("live_positions")
}

model LiveAccountSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  connectionId     String   @db.Uuid
  provider         String
  environment      String
  totalEquity      Decimal  @db.Decimal(24, 8)
  availableBalance Decimal  @db.Decimal(24, 8)
  unrealizedPnl    Decimal  @db.Decimal(24, 8)
  marginBalance    Decimal  @db.Decimal(24, 8)
  syncedAt         DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, connectionId, syncedAt])
  @@map("live_account_snapshots")
}

// ============================================================
// Phase 6.6: Automation, Scheduler & Runtime Pipeline
// ============================================================

enum PipelineRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
  SKIPPED
}

enum PipelineTrigger {
  SCHEDULE
  MANUAL
  REPLAY
  EVENT
}

enum PipelineStepType {
  AGENT
  FUSION
  DECISION
}

enum PipelineStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
  SKIPPED
}

enum PipelineScheduleMode {
  CRON
  INTERVAL
}

model PipelineSchedule {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  pipelineId      String
  symbols         String[]
  strategyIds     String[]             @default(["ai-core"])
  provider        ExchangeProvider
  mode            PipelineScheduleMode
  cron            String?
  intervalMs      Int?
  enabled         Boolean              @default(true)
  timezone        String               @default("UTC")
  maxRunsPerHour  Int                  @default(60)
  lastTriggeredAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pipelineId, provider, mode, cron, intervalMs])
  @@index([enabled, lastTriggeredAt])
  @@map("pipeline_schedules")
}

model PipelineRun {
  id                      String              @id @default(uuid()) @db.Uuid
  userId                  String              @db.Uuid
  pipelineId              String
  pipelineVersion         Int                 @default(1)
  symbol                  String
  provider                ExchangeProvider
  status                  PipelineRunStatus   @default(QUEUED)
  trigger                 PipelineTrigger
  params                  Json?
  storedContext           Json?
  result                  Json?
  startedAt               DateTime?
  completedAt             DateTime?
  durationMs              Int?
  decision                String?
  confidence              Float?
  dataQuality             String?
  skippedReason           String?
  errorCode               String?
  safeErrorMessage        String?
  traceId                 String
  correlationId           String
  replayOfRunId           String?             @db.Uuid
  scheduleId              String?             @db.Uuid
  cancellationRequestedAt DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps                   PipelineStepRun[]
  alerts                  PipelineAlert[]
  performanceRecords      PerformanceRecord[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([pipelineId, symbol, createdAt])
  @@index([correlationId])
  @@index([replayOfRunId])
  @@map("pipeline_runs")
}

enum EvaluationHorizon {
  SHORT
  MID
  LONG
}

enum PerformanceOutcome {
  CORRECT
  WRONG
  NEUTRAL
}

enum ReflectionCategory {
  RISK
  BIAS
  DATA
  TIMING
}

enum ReflectionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ImprovementProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PerformanceRecord {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  runId           String             @db.Uuid
  symbol          String
  horizon         EvaluationHorizon
  decision        String
  confidence      Float
  priceAtDecision Decimal            @db.Decimal(24, 8)
  priceAfter      Decimal            @db.Decimal(24, 8)
  outcome         PerformanceOutcome
  returnPct       Float
  highVolatility  Boolean            @default(false)
  majorNews       Boolean            @default(false)
  evaluatedAt     DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  run             PipelineRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, horizon])
  @@index([userId, evaluatedAt])
  @@index([symbol, horizon, evaluatedAt])
  @@map("performance_records")
}

model ReflectionInsight {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  summary   String
  category  ReflectionCategory
  severity  ReflectionSeverity
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reflection_insights")
}

model ImprovementProposal {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid
  description    String
  proposedChange String
  status         ImprovementProposalStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("improvement_proposals")
}

model PipelineStepRun {
  id          String             @id @default(uuid()) @db.Uuid
  runId       String             @db.Uuid
  stepId      String
  type        PipelineStepType
  status      PipelineStepStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  outputRef   Json?
  errorCode   String?
  createdAt   DateTime           @default(now())
  run         PipelineRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
  @@index([runId, createdAt])
  @@map("pipeline_step_runs")
}

model PipelineAlert {
  id               String      @id @default(uuid()) @db.Uuid
  runId            String      @db.Uuid
  kind             String
  channel          String      @default("CONSOLE")
  symbol           String
  decision         String?
  confidence       Float?
  reasoningSummary String
  delivered        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  run              PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("pipeline_alerts")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionId    String    @unique
  tokenFamily  String
  generation   Int       @default(0)
  csrfHash     String
  fingerprint  String
  rememberMe   Boolean   @default(false)
  revokedAt    DateTime?
  rotatedAt    DateTime?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("sessions")
}

model EncryptedCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  provider           CredentialProvider
  label              String?
  encryptedData      String
  lastFour           String
  status             String              @default("NOT_VERIFIED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastVerified       DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeConnection ExchangeConnection?

  @@unique([userId, provider, label])
  @@index([userId])
  @@map("encrypted_credentials")
}

model ExchangeConnection {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  provider      ExchangeProvider
  environment   ExchangeEnvironment
  credentialId  String              @unique @db.Uuid
  displayName   String?
  isEnabled     Boolean             @default(true)
  isVerified    Boolean             @default(false)
  verifiedAt    DateTime?
  permissions   Json?
  lastErrorCode String?
  lastErrorAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential    EncryptedCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, environment])
  @@index([userId])
  @@index([provider, environment])
  @@map("exchange_connections")
}

model UserSetting {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  theme               String   @default("dark")
  timezone            String   @default("UTC")
  preferredExchange   String?
  preferredSymbols    String[] @default([])
  preferredTimeframes String[] @default([])
  aiDailyBudget       Decimal  @default(0) @db.Decimal(18, 2)
  paperTradingBalance Decimal  @default(10000) @db.Decimal(24, 8)
  defaultLeverage     Int      @default(1)
  riskPreference      String   @default("CONSERVATIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Phase 4: Market Data Pipeline
// ============================================================

enum MarketDataInterval {
  i1m  @map("1m")
  i3m  @map("3m")
  i5m  @map("5m")
  i15m @map("15m")
  i30m @map("30m")
  i1h  @map("1h")
  i2h  @map("2h")
  i4h  @map("4h")
  i6h  @map("6h")
  i8h  @map("8h")
  i12h @map("12h")
  i1d  @map("1d")
  i1w  @map("1w")
  i1M  @map("1M")
}

enum GapStatus {
  DETECTED
  REPAIRING
  REPAIRED
  FAILED
  IGNORED
}

model MarketInstrument {
  id                String           @id @default(uuid()) @db.Uuid
  provider          ExchangeProvider
  symbol            String
  baseAsset         String
  quoteAsset        String
  settlementAsset   String
  instrumentType    String           @default("PERPETUAL")
  status            String           @default("TRADING")
  pricePrecision    Int
  quantityPrecision Int
  tickSize          Decimal          @db.Decimal(24, 8)
  stepSize          Decimal          @db.Decimal(24, 8)
