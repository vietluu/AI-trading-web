generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CredentialProvider {
  OPENAI
  BINANCE
  OKX
  BINANCE_FUTURES
  OKX_FUTURES
  NEWS_API
  REDDIT
  CUSTOM
}

enum ExchangeProvider {
  BINANCE_FUTURES
  OKX_FUTURES
}

enum ExchangeEnvironment {
  TESTNET
  DEMO
  PRODUCTION
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  email                  String                      @unique
  username               String                      @unique
  passwordHash           String
  failedLogins           Int                         @default(0)
  lockedUntil            DateTime?
  emailVerifiedAt        DateTime?
  totpSecret             String?
  totpEnabledAt          DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  sessions               Session[]
  credentials            EncryptedCredential[]
  setting                UserSetting?
  auditLogs              AuditLog[]
  exchangeConnections    ExchangeConnection[]
  externalDataPreference UserExternalDataPreference?
  newsStates             UserNewsState[]
  macroImportRuns        MacroImportRun[]
  aiHistories            AIHistory[]
  aiMemories             AIMemory[]
  aiConfiguration        AIConfiguration?
  aiUsages               AIUsage[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionId    String    @unique
  tokenFamily  String
  generation   Int       @default(0)
  csrfHash     String
  fingerprint  String
  rememberMe   Boolean   @default(false)
  revokedAt    DateTime?
  rotatedAt    DateTime?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("sessions")
}

model EncryptedCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  provider           CredentialProvider
  label              String?
  encryptedData      String
  lastFour           String
  status             String              @default("NOT_VERIFIED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastVerified       DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeConnection ExchangeConnection?

  @@unique([userId, provider, label])
  @@index([userId])
  @@map("encrypted_credentials")
}

model ExchangeConnection {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  provider      ExchangeProvider
  environment   ExchangeEnvironment
  credentialId  String              @unique @db.Uuid
  displayName   String?
  isEnabled     Boolean             @default(true)
  isVerified    Boolean             @default(false)
  verifiedAt    DateTime?
  permissions   Json?
  lastErrorCode String?
  lastErrorAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential    EncryptedCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, environment])
  @@index([userId])
  @@index([provider, environment])
  @@map("exchange_connections")
}

model UserSetting {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  theme               String   @default("dark")
  timezone            String   @default("UTC")
  preferredExchange   String?
  preferredSymbols    String[] @default([])
  preferredTimeframes String[] @default([])
  aiDailyBudget       Decimal  @default(0) @db.Decimal(18, 2)
  paperTradingBalance Decimal  @default(10000) @db.Decimal(24, 8)
  defaultLeverage     Int      @default(1)
  riskPreference      String   @default("CONSERVATIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Phase 4: Market Data Pipeline
// ============================================================

enum MarketDataInterval {
  i1m  @map("1m")
  i3m  @map("3m")
  i5m  @map("5m")
  i15m @map("15m")
  i30m @map("30m")
  i1h  @map("1h")
  i2h  @map("2h")
  i4h  @map("4h")
  i6h  @map("6h")
  i8h  @map("8h")
  i12h @map("12h")
  i1d  @map("1d")
  i1w  @map("1w")
  i1M  @map("1M")
}

enum GapStatus {
  DETECTED
  REPAIRING
  REPAIRED
  FAILED
  IGNORED
}

model MarketInstrument {
  id                String           @id @default(uuid()) @db.Uuid
  provider          ExchangeProvider
  symbol            String
  baseAsset         String
  quoteAsset        String
  settlementAsset   String
  instrumentType    String           @default("PERPETUAL")
  status            String           @default("TRADING")
  pricePrecision    Int
  quantityPrecision Int
  tickSize          Decimal          @db.Decimal(24, 8)
  stepSize          Decimal          @db.Decimal(24, 8)
  minQuantity       Decimal?         @db.Decimal(24, 8)
  maxQuantity       Decimal?         @db.Decimal(24, 8)
  minNotional       Decimal?         @db.Decimal(24, 8)
  contractSize      Decimal?         @db.Decimal(24, 8)
  lastSyncedAt      DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, symbol])
  @@index([provider, status])
  @@map("market_instruments")
}

model MarketCandle {
  id          String             @id @default(uuid()) @db.Uuid
  provider    ExchangeProvider
  symbol      String
  interval    MarketDataInterval
  openTime    DateTime
  closeTime   DateTime
  open        Decimal            @db.Decimal(24, 8)
  high        Decimal            @db.Decimal(24, 8)
  low         Decimal            @db.Decimal(24, 8)
  close       Decimal            @db.Decimal(24, 8)
  volume      Decimal            @db.Decimal(36, 8)
  quoteVolume Decimal?           @db.Decimal(36, 8)
  tradeCount  Int?
  isClosed    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([provider, symbol, interval, openTime])
  @@index([symbol, openTime])
  @@index([provider, symbol, interval, openTime])
  @@map("market_candles")
}

model FundingRateSnapshot {
  id              String           @id @default(uuid()) @db.Uuid
  provider        ExchangeProvider
  symbol          String
  fundingRate     Decimal          @db.Decimal(24, 12)
  fundingTime     DateTime
  nextFundingTime DateTime?
  markPrice       Decimal?         @db.Decimal(24, 8)
  createdAt       DateTime         @default(now())

  @@unique([provider, symbol, fundingTime])
  @@index([provider, symbol, fundingTime])
  @@map("funding_rate_snapshots")
}

model OpenInterestSnapshot {
  id                String           @id @default(uuid()) @db.Uuid
  provider          ExchangeProvider
  symbol            String
  openInterest      Decimal          @db.Decimal(36, 8)
  openInterestValue Decimal?         @db.Decimal(36, 8)
  recordedAt        DateTime
  createdAt         DateTime         @default(now())

  @@unique([provider, symbol, recordedAt])
  @@index([provider, symbol, recordedAt])
  @@map("open_interest_snapshots")
}

model MarketDataGap {
  id         String             @id @default(uuid()) @db.Uuid
  provider   ExchangeProvider
  symbol     String
  interval   MarketDataInterval
  gapStart   DateTime
  gapEnd     DateTime
  status     GapStatus          @default(DETECTED)
  retryCount Int                @default(0)
  lastError  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([provider, symbol, interval, gapStart])
  @@index([provider, symbol, interval, status])
  @@map("market_data_gaps")
}

model MarketStreamIncident {
  id         String           @id @default(uuid()) @db.Uuid
  provider   ExchangeProvider
  symbol     String?
  code       String
  message    String
  metadata   Json?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([provider, code, createdAt])
  @@index([createdAt])
  @@map("market_stream_incidents")
}

model IndicatorSnapshotRecord {
  id                 String             @id @default(uuid()) @db.Uuid
  provider           ExchangeProvider
  symbol             String
  interval           MarketDataInterval
  candleOpenTime     DateTime
  candleCloseTime    DateTime
  status             String             @default("CLOSED")
  values             Json
  calculationVersion Int                @default(1)
  createdAt          DateTime           @default(now())

  @@unique([provider, symbol, interval, candleOpenTime, status])
  @@index([provider, symbol, interval, candleOpenTime])
  @@map("indicator_snapshots")
}

// ============================================================
// Phase 5: External Data Ingestion Platform
// ============================================================

enum NewsSourceType {
  RSS
  ATOM
  EXCHANGE_ANNOUNCEMENT
  CRYPTO_NEWS_API
  SECURITY_FEED
  SENTIMENT_INDEX
  REDDIT
  MACRO_API
  MANUAL_IMPORT
}

enum NewsArticleStatus {
  ACTIVE
  DUPLICATE
  RETRACTED
  UNAVAILABLE
  ARCHIVED
}

enum ExchangeAnnouncementCategory {
  LISTING
  DELISTING
  FUTURES_LAUNCH
  FUTURES_DELISTING
  MAINTENANCE
  TRADING_SUSPENSION
  MARGIN_RULES
  API_CHANGE
  SECURITY_NOTICE
  PROOF_OF_RESERVES
  PROMOTION
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  INVESTIGATING
  RESOLVED
  FALSE_ALARM
}

enum SecurityIncidentType {
  EXPLOIT
  HACK
  BRIDGE_INCIDENT
  PROTOCOL_VULNERABILITY
  WALLET_COMPROMISE
  EXCHANGE_OUTAGE
  WITHDRAWAL_SUSPENSION
  STABLECOIN_DEPEG
  NETWORK_HALT
  CHAIN_REORG
  ORACLE_INCIDENT
  GOVERNANCE_ATTACK
  RUG_PULL
  REGULATORY_ENFORCEMENT
  PHISHING
}

enum VerificationStatus {
  UNVERIFIED
  SINGLE_SOURCE
  MULTI_SOURCE
  OFFICIAL_SOURCE
  RESOLVED
}

enum MarketSentimentIndexType {
  FEAR_AND_GREED
  COMMUNITY_SENTIMENT
  CUSTOM_INDEX
}

enum SocialProvider {
  REDDIT
  TWITTER
  TELEGRAM
  DISCORD
}

enum SocialPostStatus {
  ACTIVE
  REMOVED
  FLAGGED
}

enum MacroEventCategory {
  CPI
  PPI
  GDP
  UNEMPLOYMENT
  NONFARM_PAYROLLS
  INTEREST_RATE_DECISION
  CENTRAL_BANK_SPEECH
  FOMC
  RETAIL_SALES
  PMI
  DOLLAR_INDEX
  TREASURY_AUCTION
  OTHER
}

enum MacroImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MacroEventStatus {
  SCHEDULED
  RELEASED
  REVISED
  CANCELLED
  UNKNOWN
}

enum ExternalDataProvider {
  GENERIC_RSS
  BINANCE_ANNOUNCEMENTS
  OKX_ANNOUNCEMENTS
  ALTERNATIVE_ME_FEAR_GREED
  REDDIT
  MANUAL_MACRO
  X
  TELEGRAM
  DISCORD
}

enum ExternalDataHealthStatus {
  HEALTHY
  DEGRADED
  STALE
  RATE_LIMITED
  AUTHENTICATION_FAILED
  DISABLED
  NOT_CONFIGURED
  FAILED
}

model ExternalDataSource {
  id                  String                @id @default(uuid()) @db.Uuid
  sourceId            String                @unique
  displayName         String
  provider            ExternalDataProvider  @default(GENERIC_RSS)
  sourceType          NewsSourceType        @default(RSS)
  baseDomain          String
  feedUrl             String
  language            String                @default("en")
  categories          String[]              @default([])
  reliabilityScore    Int                   @default(70)
  isEnabled           Boolean               @default(true)
  isCustom            Boolean               @default(false)
  pollIntervalSeconds Int                   @default(300)
  etag                String?
  lastModified        String?
  lastFetchedAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  references          NewsSourceReference[]

  @@map("external_data_sources")
}

model NewsDuplicateGroup {
  id               String        @id @default(uuid()) @db.Uuid
  primaryArticleId String?       @unique @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  primaryArticle   NewsArticle?  @relation("PrimaryArticle", fields: [primaryArticleId], references: [id])
  articles         NewsArticle[] @relation("GroupArticles")

  @@map("news_duplicate_groups")
}

model NewsArticle {
  id                    String                @id @default(uuid()) @db.Uuid
  sourceId              String
  externalId            String?
  sourceType            NewsSourceType
  title                 String
  normalizedTitle       String
  summary               String?
  excerpt               String?
  canonicalUrl          String                @unique
  originalUrl           String?
  author                String?
  language              String?               @default("en")
  imageUrl              String?
  publishedAt           DateTime
  receivedAt            DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reliabilityScore      Int
  importanceScore       Int
  contentHash           String
  duplicateGroupId      String?               @db.Uuid
  status                NewsArticleStatus     @default(ACTIVE)
  duplicateGroup        NewsDuplicateGroup?   @relation("GroupArticles", fields: [duplicateGroupId], references: [id])
  primaryDuplicateGroup NewsDuplicateGroup?   @relation("PrimaryArticle")
  sourceReferences      NewsSourceReference[]
  symbols               ArticleSymbol[]
  topics                ArticleTopic[]
  entities              ArticleEntity[]
  userStates            UserNewsState[]

  @@index([publishedAt])
  @@index([importanceScore])
  @@index([sourceId])
  @@index([status])
  @@index([duplicateGroupId])
  @@map("news_articles")
}

model NewsSourceReference {
  id           String             @id @default(uuid()) @db.Uuid
  articleId    String             @db.Uuid
  sourceId     String
  externalId   String?
  publishedAt  DateTime
  canonicalUrl String
  source       ExternalDataSource @relation(fields: [sourceId], references: [sourceId])
  article      NewsArticle        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([sourceId])
  @@map("news_source_references")
}

model ArticleSymbol {
  id         String      @id @default(uuid()) @db.Uuid
  articleId  String      @db.Uuid
  symbol     String
  confidence Float       @default(1.0)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, symbol])
  @@index([symbol])
  @@map("article_symbols")
}

model ArticleTopic {
  id         String      @id @default(uuid()) @db.Uuid
  articleId  String      @db.Uuid
  topic      String
  confidence Float       @default(1.0)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, topic])
  @@index([topic])
  @@map("article_topics")
}

model ArticleEntity {
  id         String      @id @default(uuid()) @db.Uuid
  articleId  String      @db.Uuid
  entity     String
  entityType String
  confidence Float       @default(1.0)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, entity])
  @@index([entity])
  @@map("article_entities")
}

model ExchangeAnnouncement {
  id                     String                       @id @default(uuid()) @db.Uuid
  externalId             String?
  provider               ExchangeProvider
  category               ExchangeAnnouncementCategory
  title                  String
  summary                String?
  canonicalUrl           String                       @unique
  publishedAt            DateTime
  receivedAt             DateTime                     @default(now())
  relatedSymbols         String[]                     @default([])
  importanceScore        Int
  sourceReliabilityScore Int                          @default(100)
  rawLanguage            String?

  @@index([provider, publishedAt])
  @@index([category])
  @@index([importanceScore])
  @@map("exchange_announcements")
}

model SecurityIncident {
  id                String                    @id @default(uuid()) @db.Uuid
  externalId        String?
  title             String
  summary           String?
  incidentType      SecurityIncidentType
  severity          IncidentSeverity
  status            IncidentStatus            @default(ACTIVE)
  verificationState VerificationStatus        @default(UNVERIFIED)
  relatedSymbols    String[]                  @default([])
  relatedProtocols  String[]                  @default([])
  firstReportedAt   DateTime
  lastUpdatedAt     DateTime                  @updatedAt
  canonicalUrl      String?
  importanceScore   Int                       @default(90)
  sourceReferences  IncidentSourceReference[]

  @@index([severity])
  @@index([status])
  @@index([firstReportedAt])
  @@map("security_incidents")
}

model IncidentSourceReference {
  id           String           @id @default(uuid()) @db.Uuid
  incidentId   String           @db.Uuid
  sourceId     String
  canonicalUrl String?
  reportedAt   DateTime         @default(now())
  incident     SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_source_references")
}

model MarketSentimentObservation {
  id             String                   @id @default(uuid()) @db.Uuid
  provider       String
  indexType      MarketSentimentIndexType @default(FEAR_AND_GREED)
  value          Int
  classification String
  observedAt     DateTime
  receivedAt     DateTime                 @default(now())
  metadata       Json?

  @@unique([provider, indexType, observedAt])
  @@index([provider, observedAt])
  @@map("market_sentiment_observations")
}

model SocialPost {
  id              String           @id @default(uuid()) @db.Uuid
  provider        SocialProvider
  externalId      String
  community       String?
  title           String?
  textExcerpt     String?
  authorHash      String?
  canonicalUrl    String?
  publishedAt     DateTime
  receivedAt      DateTime         @default(now())
  engagementScore Int?
  commentsCount   Int?
  upvoteRatio     Float?
  relatedSymbols  String[]         @default([])
  topics          String[]         @default([])
  status          SocialPostStatus @default(ACTIVE)

  @@unique([provider, externalId])
  @@index([provider, publishedAt])
  @@map("social_posts")
}

model MacroEconomicEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    String
  externalId  String?
  name        String
  country     String?
  currency    String?
  category    MacroEventCategory
  importance  MacroImportance
  scheduledAt DateTime
  actual      String?
  forecast    String?
  previous    String?
  unit        String?
  status      MacroEventStatus   @default(SCHEDULED)
  sourceUrl   String?
  receivedAt  DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([provider, name, scheduledAt])
  @@index([scheduledAt])
  @@index([importance])
  @@index([category])
  @@map("macro_economic_events")
}

model MacroImportRun {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  fileName     String
  fileFormat   String
  totalRows    Int
  acceptedRows Int
  rejectedRows Int
  errors       Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("macro_import_runs")
}

model ExternalDataIngestionRun {
  id                 String               @id @default(uuid()) @db.Uuid
  provider           ExternalDataProvider
  sourceId           String?
  itemsReceived      Int                  @default(0)
  itemsAccepted      Int                  @default(0)
  duplicatesDetected Int                  @default(0)
  itemsRejected      Int                  @default(0)
  durationMs         Int
  status             String
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime
  completedAt        DateTime

  @@index([provider, startedAt])
  @@map("external_data_ingestion_runs")
}

model ExternalDataProviderHealth {
  id                  String                   @id @default(uuid()) @db.Uuid
  provider            ExternalDataProvider     @unique
  status              ExternalDataHealthStatus @default(NOT_CONFIGURED)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastItemAt          DateTime?
  consecutiveFailures Int                      @default(0)
  averageLatencyMs    Int                      @default(0)
  lastErrorCode       String?
  rateLimitResetAt    DateTime?
  itemsFetchedTotal   Int                      @default(0)
  itemsAcceptedTotal  Int                      @default(0)
  metadata            Json?
  updatedAt           DateTime                 @updatedAt

  @@map("external_data_provider_health")
}

model UserExternalDataPreference {
  id                           String          @id @default(uuid()) @db.Uuid
  userId                       String          @unique @db.Uuid
  preferredLanguage            String          @default("en")
  followedSymbols              String[]        @default([])
  followedTopics               String[]        @default([])
  hiddenSourceIds              String[]        @default([])
  minImportanceScore           Int             @default(0)
  highImportanceAlertThreshold Int             @default(70)
  macroCountries               String[]        @default([])
  minMacroImportance           MacroImportance @default(LOW)
  redditCommunities            String[]        @default([])
  realtimeNewsEnabled          Boolean         @default(true)
  autoMarkRead                 Boolean         @default(false)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  user                         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_external_data_preferences")
}

model UserNewsState {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  articleId String      @db.Uuid
  isRead    Boolean     @default(false)
  isSaved   Boolean     @default(false)
  isHidden  Boolean     @default(false)
  readAt    DateTime?
  savedAt   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, isSaved])
  @@index([userId, isRead])
  @@map("user_news_states")
}

// ============================================================
// Phase 6.1: AI Infrastructure
// ============================================================

enum AIMemoryType {
  CONVERSATION
  DECISION
  OBSERVATION
  REFLECTION
  MARKET_SNAPSHOT
}

enum AIProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
}

model AIHistory {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  sessionId        String?
  provider         AIProviderType
  model            String
  prompt           String
  systemPrompt     String?
  response         String
  responseJson     Json?
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  estimatedCost    Decimal        @default(0) @db.Decimal(18, 6)
  latencyMs        Int            @default(0)
  success          Boolean        @default(true)
  finishReason     String?
  error            String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, model])
  @@map("ai_histories")
}

model AIMemory {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  sessionId  String?
  type       AIMemoryType
  key        String
  content    Json
  importance Int          @default(50)
  tags       String[]     @default([])
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("ai_memories")
}

model AIConfiguration {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique @db.Uuid
  preferredProvider AIProviderType @default(OPENAI)
  preferredModel    String         @default("gpt-5-mini")
  temperature       Float          @default(0.7)
  maxTokens         Int            @default(2048)
  timeoutMs         Int            @default(30000)
  dailyBudget       Decimal        @default(10.00) @db.Decimal(18, 2)
  monthlyBudget     Decimal        @default(100.00) @db.Decimal(18, 2)
  tokenBudget       Int            @default(1000000)
  requestBudget     Int            @default(1000)
  fallbackEnabled   Boolean        @default(true)
  fallbackProviders String[]       @default(["ANTHROPIC", "GEMINI", "OLLAMA"])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_configurations")
}

model AIUsage {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  date             String
  requestCount     Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  totalCost        Decimal  @default(0) @db.Decimal(18, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("ai_usages")
}

