  outputTokens        Int                   @default(0)
  cachedTokens        Int                   @default(0)
  estimatedCost       Decimal               @default(0) @db.Decimal(18, 6)
  actualCost          Decimal?              @db.Decimal(18, 6)
  toolCallCount       Int                   @default(0)
  toolRoundCount      Int                   @default(0)
  retryCount          Int                   @default(0)
  failureCode         String?
  safeFailureMessage  String?
  traceId             String?
  correlationId       String?
  parentRunId         String?               @db.Uuid
  replayOfRunId       String?               @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextSnapshot AgentContextSnapshot? @relation(fields: [contextSnapshotId], references: [id])
  transitions     AgentRunTransition[]
  runOutput       AgentRunOutput?

  @@index([userId, createdAt])
  @@index([agentType, status])
  @@index([correlationId])
  @@index([parentRunId])
  @@index([replayOfRunId])
  @@index([traceId])
  @@map("agent_runs")
}

model AgentRunTransition {
  id            String         @id @default(uuid()) @db.Uuid
  runId         String         @db.Uuid
  fromState     AgentRunStatus
  toState       AgentRunStatus
  reason        String
  actor         String
  correlationId String?
  createdAt     DateTime       @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("agent_run_transitions")
}

model AgentContextSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @db.Uuid
  symbol            String?
  provider          String?
  timeframe         String?
  sourceDataCutoff  DateTime
  schemaVersion     Int      @default(1)
  builderVersion    String   @default("1.0.0")
  contextHash       String
  tokenEstimate     Int      @default(0)
  serializedContext Json
  marketRefs        String[] @default([])
  newsRefs          String[] @default([])
  macroRefs         String[] @default([])
  sentimentRefs     String[] @default([])
  memoryRefs        String[] @default([])
  createdAt         DateTime @default(now())

  agentRuns AgentRun[]

  @@index([contextHash])
  @@index([userId, createdAt])
  @@map("agent_context_snapshots")
}

model AgentRunOutput {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @unique @db.Uuid
  schemaVersion   Int      @default(1)
  validatedOutput Json
  rawOutput       String?
  createdAt       DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("agent_run_outputs")
}

model AgentQuotaUsage {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  windowKey   String
  runCount    Int      @default(0)
  tokenCount  Int      @default(0)
  costTotal   Decimal  @default(0) @db.Decimal(18, 6)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowKey])
  @@index([userId, windowKey])
  @@map("agent_quota_usages")
}

// ============================================================
// Phase 10.3A: Research & Validation Models
// ============================================================

model ResearchValidationRun {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String?  @db.Uuid
  symbol                String
  provider              String
  interval              String
  lookbackCandles       Int
  monteCarloSimulations Int      @default(10000)
  probabilityOfProfit   Float
  probabilityOfRuin     Float
  expectedDrawdown      Float
  worstDrawdown         Float
  walkForwardStable     Boolean
  walkForwardAvgReturn  Float
  bootstrapSharpe95     Float[]
  confidenceBrierScore  Float
  regimeStabilityScore  Float
  crossSymbolRank       Int      @default(1)
  outOfSampleSharpe     Float
  metricsJson           Json
  createdAt             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([symbol, provider])
  @@map("research_validation_runs")
}

model BenchmarkSuiteRun {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid
  symbol           String
  provider         String
  interval         String
  strategyCount    Int      @default(20)
  topStrategyName  String
  leaderboardJson  Json
  recommendations  Json
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([symbol, provider])
  @@map("benchmark_suite_runs")
}

model SensitivityHeatmap {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  symbol          String
  parameterName   String
  gridValues      Json
  metricsSurface  Json
  optimalValue    Float
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, parameterName])
  @@map("sensitivity_heatmaps")
}

