# Backend
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/crypto_platform?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=86400
REMEMBER_ME_TTL=2592000
SESSION_FINGERPRINT_ENABLED=true
# Leave false behind mobile networks/reverse proxies unless trusted proxy IPs are configured.
SESSION_FINGERPRINT_BIND_IP=false
EMAIL_VERIFICATION_ENABLED=false
WEB_APP_URL=http://localhost:3000
# Required only when EMAIL_VERIFICATION_ENABLED=true
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
PASSWORD_BREACH_CHECK_ENABLED=false
TOTP_REQUIRED_FOR_SENSITIVE_ACTIONS=false
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_TESTNET_BASE_URL=https://testnet.binancefuture.com
OKX_BASE_URL=https://www.okx.com
OKX_DEMO_TRADING_ENABLED=true
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_BUSINESS_URL=wss://ws.okx.com:8443/ws/v5/business
EXCHANGE_HTTP_TIMEOUT_MS=10000
EXCHANGE_MAX_RETRIES=2
EXCHANGE_RETRY_BASE_DELAY_MS=300
EXCHANGE_PUBLIC_RATE_LIMIT_ENABLED=true
EXCHANGE_PRIVATE_RATE_LIMIT_ENABLED=true
EXCHANGE_PUBLIC_RATE_LIMIT_PER_MINUTE=1200
EXCHANGE_PRIVATE_RATE_LIMIT_PER_MINUTE=1200
EXCHANGE_INSTRUMENT_CACHE_TTL_SECONDS=3600
EXCHANGE_TICKER_CACHE_TTL_SECONDS=3
EXCHANGE_TIME_OFFSET_CACHE_TTL_SECONDS=300
EXCHANGE_PRODUCTION_CONNECTIONS_ENABLED=false
EXCHANGE_REQUIRE_RECENT_AUTH=true
EXCHANGE_RECENT_AUTH_TTL_SECONDS=600
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Frontend (values prefixed with NEXT_PUBLIC_ are exposed to the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Docker Compose local infrastructure
POSTGRES_DB=crypto_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev

# Phase 6.1 & 6.2: AI Infrastructure & Tool Calling Framework
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=GEMINI
DEFAULT_MODEL=gemini-3.1-flash-lite
DEFAULT_MAX_TOKENS=2048
DEFAULT_TEMPERATURE=0.7

AI_TOOL_CALLING_ENABLED=true
AI_TOOL_MANUAL_TEST_ENABLED=false
AI_TOOL_MAX_ROUNDS=5
AI_TOOL_MAX_CALLS_PER_REQUEST=10
AI_TOOL_MAX_PARALLEL_CALLS=3
AI_TOOL_RECURSION_LIMIT=2
AI_TOOL_IDENTICAL_CALL_LIMIT=2
AI_TOOL_DEFAULT_TIMEOUT_MS=10000
AI_TOOL_TOTAL_REQUEST_TIMEOUT_MS=60000
AI_TOOL_MAX_ARGUMENT_BYTES=32768
AI_TOOL_MAX_RESULT_BYTES=262144
AI_TOOL_MAX_RESULT_TOKENS_PER_REQUEST=12000
AI_TOOL_MAX_CALLS_PER_MINUTE=30
AI_TOOL_MAX_CALLS_PER_HOUR=500
AI_TOOL_MAX_CALLS_PER_DAY=5000

# Phase 6.3: Multi-Agent Framework
AGENT_FRAMEWORK_ENABLED=true
AGENT_MANUAL_RUN_ENABLED=true
AGENT_SYSTEM_DIAGNOSTIC_ENABLED=true
AGENT_DEFAULT_TIMEOUT_MS=60000
AGENT_MAX_GLOBAL_CONCURRENCY=10
AGENT_MAX_USER_CONCURRENCY=10
AGENT_MAX_TYPE_CONCURRENCY=5
AGENT_MAX_RUNS_PER_MINUTE=30
AGENT_MAX_RUNS_PER_HOUR=500
AGENT_MAX_RUNS_PER_DAY=5000
AGENT_MAX_RETRY_ATTEMPTS=2
AGENT_IDEMPOTENCY_TTL_SECONDS=60
AGENT_RUN_RETENTION_DAYS=90

# Phase 6.6: automated research pipeline (does not execute trades)
PIPELINE_ENABLED=true
PIPELINE_MAX_CONCURRENCY=5
PIPELINE_COOLDOWN_MS=60000
PIPELINE_MAX_RUNS_PER_HOUR=60
MIN_CONFIDENCE=60

# Phase 6.7: virtual evaluation only; proposals require explicit human review
REFLECTION_ENABLED=true
EVALUATION_DELAY_MS=600000
MIN_RECORDS_FOR_REFLECTION=20
REFLECTION_ACCURACY_ALERT_THRESHOLD=50

# Phase 7: simulated execution only (never sends exchange orders)
TRADING_MODE=DEMO
GLOBAL_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
LIVE_POSITION_SYNC_ENABLED=true
LIVE_POSITION_SYNC_INTERVAL_MS=30000
LIVE_RISK_APPROVAL_TTL_MS=300000
RISK_PER_TRADE=0.02
DEFAULT_LEVERAGE=3
TRADE_COOLDOWN_MS=60000
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# Phase 8: mandatory pre-execution portfolio risk controls
MAX_POSITIONS=3
MAX_LEVERAGE=3
MAX_DRAWDOWN=0.15
MAX_EXPOSURE=0.6
RISK_REWARD_RATIO=2
HIGH_VOLATILITY_THRESHOLD=0.04
ABNORMAL_VOLATILITY_THRESHOLD=0.15
HIGH_VOLATILITY_SIZE_FACTOR=0.6

# Phase 10: multi-strategy portfolio controls
MAX_STRATEGIES=5
MAX_TOTAL_EXPOSURE=0.6
MAX_STRATEGY_EXPOSURE=0.25
MAX_DRAWDOWN_PORTFOLIO=0.2
STRATEGY_DISABLE_MIN_TRADES=10
STRATEGY_DISABLE_RETURN_PCT=-0.1
STRATEGY_DISABLE_WIN_RATE=0.35
PORTFOLIO_REBALANCE_INTERVAL_MS=3600000
