# ============================================================
# AI Trading Agents - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Database (PostgreSQL) ---
DATABASE_URL=******localhost:5432/trading_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=300

# --- OKX Exchange API ---
OKX_API_KEY=your-okx-api-key
OKX_API_SECRET=your-okx-api-secret
OKX_PASSPHRASE=your-okx-passphrase
OKX_SANDBOX=true
OKX_BASE_URL=https://www.okx.com
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_PRIVATE_URL=wss://ws.okx.com:8443/ws/v5/private

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# --- CryptoPanic News API ---
CRYPTOPANIC_API_KEY=your-cryptopanic-api-key
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1

# --- Glassnode On-Chain Metrics ---
GLASSNODE_API_KEY=your-glassnode-api-key
GLASSNODE_BASE_URL=https://api.glassnode.com

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Trading Configuration ---
DEFAULT_LEVERAGE=1
MAX_POSITION_SIZE_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
RISK_PER_TRADE_PCT=0.02
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TAKE_PROFIT_PCT=0.04

# --- Paper Trading ---
PAPER_TRADING_INITIAL_BALANCE=100000.0
PAPER_TRADING_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Monitoring ---
PROMETHEUS_PORT=9090
